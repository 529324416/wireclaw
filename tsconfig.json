{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* 运行环境：ES2023 + Web 标准；共享代码同时面向浏览器与 Node >= 20。
       Node 专用实现（local / MCP stdio / client.ts）仍通过 types: node 获得类型。 */
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    /* 类型严格度 */
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    /* ESM 语义：要求 type-only 导入显式写成 import type，
       避免 tsx / Node ESM 在运行期导入并不存在的类型绑定 */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* 工具链 */
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tools/**/*.ts", "client.ts", "harness.ts", "harness-runtime.ts", "harness-comic.ts"],
  "exclude": ["node_modules", "dist", "test", "test.ts"]
}
