{
  "name": "wireclaw",
  "version": "0.1.1",
  "description": "Wireclaw — an embeddable AI harness module",
  "keywords": [
    "ai",
    "agent",
    "harness",
    "llm",
    "mcp"
  ],
  "license": "MIT",
  "author": "biscuit",
  "type": "module",
  "main": "./dist/browser/index.js",
  "module": "./dist/browser/index.js",
  "types": "./dist/types/browser.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/browser.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./browser": {
      "types": "./dist/types/browser.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node/node.js",
      "default": "./dist/node/node.js"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "import": "./dist/node/client.js",
      "default": "./dist/node/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "architecture.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsup && node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.browser.json",
    "typecheck:node": "node ./node_modules/typescript/bin/tsc --noEmit",
    "typecheck:browser": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.browser.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
