# ---------------------------------------------------------------------------
# 依赖与包缓存：第三方 npm 包一律不入库
# ---------------------------------------------------------------------------
node_modules/
.npm-cache/
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# 测试脚本与测试夹具已重新入库（见 test/）
# 仅保留本地临时脚本入口
# ---------------------------------------------------------------------------
/test.ts

# 本地参考 CLI 会话数据（运行时产物，不入库）
/wireclaw-session.json
/wireclaw-session.json.attachments.json

# ---------------------------------------------------------------------------
# 构建产物与缓存
# ---------------------------------------------------------------------------
/dist/
/coverage/
*.tsbuildinfo

# 本地附件仓库（LocalFileHost 默认目录）
/.wireclaw-files/
/.rotom-files/

# 本地实机测试输出
/.minimax-test-output/
/harness-output/
/comic-output/

# 本地 API key / 环境变量
/ds-apikey.txt
/apikey*.txt
/.env
/.env.*
/modelOverwrite.json

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# dev.log 是项目开发日志，需要入库
!dev.log/
!dev.log/**
